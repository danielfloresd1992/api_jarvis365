{
    "compilerOptions": {
        "typeRoots": ["./node_modules/@types", "./src/types"],
        "target": "es2022",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"],
        "noEmit": true
    },
    "include": ["src/__probe__/**/*", "src/types/express.d.ts"]
}
